import math

def calculate_distance(x1, y1, x2, y2):
    distance = math.sqrt((x1 - x2) ** 2 + (y1 - y2) ** 2)
    return distance

x1, y1 = map(float, input("Введите координаты первой точки(x и y): ").split())
x2, y2 = map(float, input("Введите координаты второй точки(x и y): ").split())

print(f"Расстояние между точками: {calculate_distance(x1, y1, x2, y2):.2f} метров")
